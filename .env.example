# Nothing here needs to be set by hand on Vercel: the Upstash for Redis
# integration adds both values to the project automatically.
#
# For local development, leave them empty to use throwaway in-memory storage,
# or copy this file to .env.local and paste the values from
# Vercel → Storage → your database.
KV_REST_API_URL=
KV_REST_API_TOKEN=
